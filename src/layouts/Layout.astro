---
import Footer from '@/components/Footer.astro';
import ForestSky from '@/components/ForestSky.astro';
import Header from '@/components/Header.astro';
import type { Locale } from '@/libs/i18n';
import '@/styles/globals.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  locale?: Locale;
  isHome?: boolean;
}

const {
  title,
  description = '',
  keywords = '',
  locale = 'en',
  isHome = false,
} = Astro.props;

const mainClasses = [
  'w-full max-w-2xl mx-auto px-6',
  isHome ? 'flex flex-auto items-center justify-center py-12' : 'py-16',
].join(' ');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZJ7C2QM9W7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-ZJ7C2QM9W7');
    </script>
  </head>
  <body class="bg-background text-foreground">
    <div
      class:list={['min-h-screen flex flex-col', { 'home-sky': isHome }]}
    >
      {isHome && <ForestSky locale={locale} />}
      <Header locale={locale} pathname={Astro.url.pathname} />
      <main class={mainClasses}>
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>

<style>
  .home-sky {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
  }
</style>
