---
import { type Locale, t } from '@/libs/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<forest-sky
  data-pause={t(locale, 'pages.home.motion.pause')}
  data-play={t(locale, 'pages.home.motion.play')}
>
  <canvas aria-hidden="true"></canvas>
  <button type="button" hidden aria-label={t(locale, 'pages.home.motion.pause')}>
    <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
      <path class="pause" d="M6 5h2v10H6zm6 0h2v10h-2z" />
      <path class="play" d="m7 4 9 6-9 6z" />
    </svg>
  </button>
</forest-sky>

<script>
  class ForestSky extends HTMLElement {
    private cleanup?: () => void;
    private generation = 0;

    async connectedCallback() {
      const generation = ++this.generation;
      try {
        const { mountForest } = await import('@/libs/forest-sky');
        if (!this.isConnected || generation !== this.generation) return;
        this.cleanup = mountForest(this);
      } catch {
        // The scene is decorative; the plain dark page remains the fallback.
      }
    }

    disconnectedCallback() {
      this.generation++;
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }

  if (!customElements.get('forest-sky')) {
    customElements.define('forest-sky', ForestSky);
  }
</script>

<style>
  forest-sky {
    display: contents;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }

  button {
    position: absolute;
    right: max(1.5rem, calc((100% - 42rem) / 2 + 1.5rem));
    bottom: 5rem;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--color-muted);
    cursor: pointer;
    opacity: 0.65;
  }

  button[hidden] {
    display: none;
  }

  button:hover,
  button:focus-visible {
    opacity: 1;
  }

  .play,
  [data-paused='true'] .pause {
    display: none;
  }

  [data-paused='true'] .play {
    display: block;
  }
</style>
